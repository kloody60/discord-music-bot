{
  "name": "discord-music-bot",
  "version": "1.0.2",
  "private": true,
  "type": "module",
  "main": "electron/main.mjs",
  "scripts": {
    "start": "electron .",
    "bot": "node src/index.js",
    "setup": "node scripts/setup-ytdlp.mjs",
    "dist": "electron-builder --win nsis --publish never"
  },
  "dependencies": {
    "@discordjs/voice": "^0.19.2",
    "discord.js": "^14.28.1",
    "dotenv": "^18.0.10",
    "electron-updater": "^6.8.11",
    "express": "^5.3.0",
    "ffmpeg-static": "^5.3.0",
    "libsodium-wrappers": "^0.8.4",
    "opusscript": "^0.0.8"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0"
  },
  "description": "Discord music bot with a desktop control panel / بوت موسيقى ديسكورد مع لوحة تحكم",
  "author": "Khalid",
  "build": {
    "appId": "com.khalid.musicbot",
    "productName": "Music Bot",
    "directories": {
      "output": "dist"
    },
    "files": [
      "electron/**",
      "src/**",
      "public/**",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico",
      "signExecutable": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "بوت الموسيقى",
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "artifactName": "Music-Bot-Setup-${version}.exe"
    },
    "asarUnpack": [
      "node_modules/ffmpeg-static/**"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "kloody60",
        "repo": "discord-music-bot"
      }
    ]
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/kloody60/discord-music-bot.git"
  }
}