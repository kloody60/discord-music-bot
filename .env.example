# توكن البوت من https://discord.com/developers/applications
DISCORD_TOKEN=
# كلمة سر لوحة التحكم (اتركها فاضية لو تبي اللوحة محلية بدون كلمة سر)
DASHBOARD_PASSWORD=
PORT=3000
# 127.0.0.1 = من جهازك فقط. حط 0.0.0.0 لو تبي توصلها من جهاز ثاني (لازم كلمة سر)
HOST=127.0.0.1
# اختياري: ملف كوكيز (صيغة Netscape) لروابط انستغرام/تيك توك اللي تطلب تسجيل دخول
COOKIES_FILE=
# اختياري: مسار yt-dlp أو ffmpeg لو مو في PATH
YTDLP_PATH=
